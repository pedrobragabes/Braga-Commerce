# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Acesso temporário ao beta (somente server-side; deixe vazio no desenvolvimento)
SITE_ACCESS_PASSWORD=
SITE_ACCESS_SECRET=

# Jobs autenticados, rate limiting e e-mail (somente server-side)
JOB_SECRET=
RATE_LIMIT_SECRET=
EMAIL_DRIVER=development
# Optional Google provider: enable only after configuring Supabase OAuth.
AUTH_GOOGLE_ENABLED=false
EMAIL_FROM=
RESEND_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/braga_commerce?schema=public
# PEM da CA do banco; obrigatório para sslmode=verify-full em produção
DATABASE_SSL_CA=
# Somente QA em loopback com NODE_ENV=production; nunca desativa TLS remoto.
DATABASE_ALLOW_INSECURE_LOCAL=false

# Supabase Auth do painel (Milestone 4)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap inicial do operador (somente para npm run admin:bootstrap)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador PV Moda
ADMIN_ROLE=OWNER

# Mercado Pago Checkout Pro (Milestone 3)
# Mapa versionado server-only. Ver docs/23-tenant-payment-and-database-tls.md.
MERCADO_PAGO_ACCOUNTS_JSON=
MERCADO_PAGO_LEGACY_ACCOUNT_KEY=
# Variáveis antigas abaixo não ativam recebimento sem o mapa explícito.
MERCADO_PAGO_ENV=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_STORE_SLUG=pv-moda-masculina

# Contexto público por domínio aprovado ou loja fixa desta instância
STORE_SLUG=pv-moda-masculina
STORE_PUBLIC_ALLOWED_HOSTS=

# Ponte BES v1: somente leitura, chave forte (mínimo 32 caracteres) no servidor
BES_BRIDGE_API_KEY=
BES_BRIDGE_STORE_IDS=
BES_ALLOWED_ORIGINS=
BES_BRIDGE_MODE=production

# Catálogo BES v2, separado do vínculo v1 e desativado por padrão.
# Segredos aleatórios >=32 bytes; nunca NEXT_PUBLIC_ nem enviados ao navegador.
BES_CATALOG_ENABLED=false
BES_CATALOG_KEY_ID=
BES_CATALOG_API_KEY=
BES_CATALOG_STORE_IDS=
BES_CATALOG_IMAGE_HOSTS=
BES_CATALOG_PREVIOUS_KEY_ID=
BES_CATALOG_PREVIOUS_API_KEY=
BES_CATALOG_PREVIOUS_STORE_IDS=
BES_CATALOG_ROTATION_STARTED_AT=
BES_CATALOG_PREVIOUS_VALID_UNTIL=

# Storage de imagens de produto (Milestone 5)
STORAGE_BUCKET=product-images

# Store seed
SEED_STORE_NAME=PV Moda Masculina
SEED_STORE_SLUG=pv-moda-masculina
SEED_STORE_WHATSAPP=
SEED_ALLOW_LOCAL_DELIVERY=true
SEED_LOCAL_DELIVERY_FEE_CENTS=0
