generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  logoUrl   String?
  whatsapp  String?
  email     String?
  address   String?
  city      String?
  state     String?
  isActive  Boolean  @default(true)
  salesAccessMode SalesAccessMode @default(ASSISTED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  categories Category[]
  products   Product[]
  orders     Order[]
  settings   StoreSettings?
  emailOutbox EmailOutbox[]
  stockAdjustments StockAdjustment[]
  customers Customer[]
  themeRevisions StoreThemeRevision[]
  auditEvents StoreAuditEvent[]
  subscription Subscription?
  application StoreApplication?
  directoryBinding StoreDirectoryBinding?
  paymentAccounts PaymentAccountBinding[]
}

model StockAdjustment {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actorId        String
  productId      String
  variantId      String?
  requestId      String
  quantityBefore Int
  delta          Int
  quantityAfter  Int
  reason         String
  createdAt      DateTime @default(now())

  @@unique([storeId, requestId])
  @@index([storeId, productId, createdAt])
}

model StoreSettings {
  id                    String   @id @default(cuid())
  storeId               String   @unique
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  primaryColor          String?
  secondaryColor        String?
  currency              String   @default("BRL")
  allowLocalPickup      Boolean  @default(true)
  allowLocalDelivery    Boolean  @default(false)
  localDeliveryFeeCents Int?
  freeShippingFromCents Int?
  mercadoPagoPublicKey  String?
  mercadoPagoEnabled    Boolean  @default(false)
  themeVersion          Int      @default(0)
  themeDraftVersion     Int?
  themePublishedVersion Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model User {
  id         String   @id @default(cuid())
  authUserId String?
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  email      String
  role       UserRole @default(ADMIN)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storeId, role])
  @@unique([storeId, authUserId])
  @@unique([storeId, email])
}

enum SalesAccessMode {
  LEGACY_PILOT
  ASSISTED
}

model StoreThemeRevision {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  version Int
  contractVersion Int @default(1)
  content Json
  actorId String
  createdAt DateTime @default(now())

  @@unique([storeId, version])
}

model StoreAuditEvent {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actorId String
  action String
  reference String
  reason String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

model PlatformOperator {
  id String @id @default(cuid())
  authUserId String @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
}

model StoreDirectoryBinding {
  id String @id @default(cuid())
  storeId String @unique
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  commerceId Int
  origin String
  challengeHash String
  actorId String
  catalogSharingEnabled Boolean @default(false)
  catalogConsentActorId String?
  catalogConsentActorUpdatedAt DateTime?
  catalogConsentAt DateTime?
  catalogConsentScopeVersion Int?
  catalogConsentRevision String @default(dbgenerated("(gen_random_uuid())::text"))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([origin, commerceId])
}

model Plan {
  id String @id @default(cuid())
  code String
  version Int
  name String
  conditions String
  priceCents Int?
  currency String @default("BRL")
  checkoutEnabled Boolean @default(true)
  isPublished Boolean @default(false)
  createdBy String
  createdAt DateTime @default(now())
  subscriptions Subscription[]
  applications StoreApplication[]

  @@unique([code, version])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  ENDING
  CANCELLED
  SUSPENDED
}

enum ActivationOrigin {
  ADMINISTRATIVE
  COURTESY
  EXTERNAL_CONFIRMATION
}

model Subscription {
  id String @id @default(cuid())
  storeId String @unique
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId String
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  status SubscriptionStatus @default(PENDING)
  startsAt DateTime?
  endsAt DateTime?
  activationOrigin ActivationOrigin?
  confirmedBy String?
  confirmationReference String?
  acceptedPlanVersion Int
  acceptedAt DateTime
  acceptedBy String
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StoreApplicationStatus {
  REQUESTED
  PROVISIONED
  REJECTED
}

model StoreApplication {
  id String @id @default(cuid())
  requestKey String @unique
  requesterAuthUserId String
  requesterName String
  requesterEmail String
  storeName String
  storeSlug String
  planId String?
  plan Plan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  acceptedPlanVersion Int?
  acceptedAt DateTime?
  status StoreApplicationStatus @default(REQUESTED)
  storeId String? @unique
  store Store? @relation(fields: [storeId], references: [id], onDelete: Restrict)
  decidedBy String?
  decidedAt DateTime?
  decisionReason String?
  createdAt DateTime @default(now())

  @@index([requesterAuthUserId, createdAt])
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model Category {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, slug])
}

model Product {
  id               String           @id @default(cuid())
  storeId          String
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name             String
  slug             String
  description      String?
  shortDescription String?
  sku              String?
  basePriceCents   Int
  stockQuantity   Int              @default(0)
  compareAtCents   Int?
  isActive         Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  hasVariants      Boolean          @default(false)
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([storeId, slug])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  storagePath String? @unique
  storageBucket String?
  alt         String?
  sortOrder   Int     @default(0)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  sku           String?
  size          String?
  color         String?
  priceCents    Int?
  stockQuantity Int         @default(0)
  isActive      Boolean     @default(true)
  orderItems    OrderItem[]

  @@unique([productId, sku])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  authUserId String?
  isQuarantined Boolean @default(true)
  legacyCustomerId String?
  name      String
  email     String?
  phone     String
  document  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@unique([id, storeId])
  @@unique([storeId, authUserId])
  @@index([storeId, phone])
  @@index([legacyCustomerId])
}

model Order {
  id                       String            @id @default(cuid())
  storeId                  String
  store                    Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customerId               String
  customer                 Customer          @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  status                   OrderStatus       @default(PENDING)
  paymentStatus            PaymentStatus    @default(WAITING_PAYMENT)
  fulfillmentStatus        FulfillmentStatus @default(NOT_FULFILLED)
  subtotalCents            Int
  shippingCents            Int               @default(0)
  discountCents            Int               @default(0)
  totalCents               Int
  deliveryMethod           DeliveryMethod    @default(LOCAL_PICKUP)
  customerName             String
  customerPhone            String
  customerEmail            String?
  shippingZipCode          String?
  shippingStreet           String?
  shippingNumber           String?
  shippingComplement       String?
  shippingNeighborhood     String?
  shippingCity             String?
  shippingState            String?
  mercadoPagoPreferenceId  String?
  mercadoPagoPaymentId     String?
  paymentAccountKey        String?
  paymentAccount           PaymentAccountBinding? @relation(fields: [paymentAccountKey, storeId], references: [key, storeId], onDelete: Restrict, onUpdate: Restrict)
  paymentLegacy            Boolean @default(false)
  notes                    String?
  internalNote             String?
  items                    OrderItem[]
  paymentEvents            PaymentEvent[]
  emailOutbox              EmailOutbox[]
  inventoryStatus          InventoryStatus   @default(NOT_RESERVED)
  operationVersion         Int               @default(0)
  inventoryResolutions     OrderInventoryResolution[]
  reservedAt               DateTime?
  expiresAt                DateTime?
  stockCommittedAt         DateTime?
  stockReleasedAt          DateTime?
  paidAt                   DateTime?
  cancelledAt              DateTime?
  refundedAt               DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([storeId, status])
  @@index([customerId])
  @@index([mercadoPagoPaymentId])
  @@index([inventoryStatus, expiresAt])
  @@index([storeId, paidAt])
  @@unique([id, storeId])
}

model OrderInventoryResolution {
  id String @id @default(cuid())
  storeId String
  orderId String
  order Order @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  actorId String
  requestId String
  action String
  reason String
  previousVersion Int
  createdAt DateTime @default(now())
  @@unique([storeId, requestId])
  @@index([orderId, createdAt])
}

// Configuration identity only. Provider credentials remain server environment secrets.
model PaymentAccountBinding {
  key String @id
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  collectorId String
  environment String
  createdAt DateTime @default(now())
  orders Order[]
  @@unique([key, storeId])
  @@index([storeId])
}

// No cascading FK: pending object cleanup must survive catalog/store deletion.
model StorageDeletionJob {
  id String @id @default(cuid())
  storeId String
  productId String
  imageId String? @unique
  actorId String
  bucket String
  storagePath String
  reason String
  status String @default("PENDING")
  attempts Int @default(0)
  claimToken String?
  lockedUntil DateTime?
  nextAttemptAt DateTime @default(now())
  lastErrorCode String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([bucket, storagePath])
  @@index([status, nextAttemptAt])
  @@index([storeId, productId, status])
}

enum InventoryStatus {
  NOT_RESERVED
  RESERVED
  COMMITTED
  RELEASED
  REQUIRES_REVIEW
}

model PaymentEvent {
  id              String   @id @default(cuid())
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  eventKey         String   @unique
  provider         String
  providerEventId  String
  providerStatus   String
  eventType        String
  result           String
  requestId        String?
  processedAt      DateTime?
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@index([provider, providerEventId])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName    String
  variantName    String?
  sku            String?
  quantity       Int
  unitPriceCents Int
  totalCents     Int
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model EmailOutbox {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventKey      String         @unique
  type          EmailType
  status        EmailStatus    @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  sentAt        DateTime?
  lastErrorCode String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([orderId])
}

enum EmailType {
  ORDER_CREATED
  PAYMENT_CONFIRMED
  ORDER_CANCELLED
  PAYMENT_REFUNDED
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  WAITING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  NOT_FULFILLED
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  LOCAL_PICKUP
  LOCAL_DELIVERY
  SHIPPING
}
